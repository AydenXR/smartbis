# --- Etapa 1: Compilar la aplicación con Node.js ---
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# --- Etapa 2: Servir con Nginx limpio ---
FROM nginx:1.27-alpine AS runner

ENV TZ=America/Hermosillo
RUN apk add --no-cache tzdata curl \
 && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Copiamos la carpeta dist generada automáticamente en la Etapa 1
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.docker.conf /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -fsS http://127.0.0.1:5174/ || exit 1

EXPOSE 5174

CMD ["nginx", "-g", "daemon off;"]