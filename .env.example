# LLM Config
# Compatible con la mayoria de proveedores OpenAI-compatible
# xAI:        https://api.x.ai/v1/chat/completions
# OpenRouter: https://openrouter.ai/api/v1/chat/completions
# Groq:       https://api.groq.com/openai/v1/chat/completions

LLM_API_KEY=tu_api_key_aqui
LLM_MODEL_NAME=grok-4.3
LLM_BASE_URL=https://api.x.ai/v1/chat/completions
LLM_FALLBACK_MODEL=google/gemma-4-31b-it:free
LLM_MAX_TOKENS=420

# DB Config
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_publishable_key_aqui
SUPABASE_SECRET_KEY=tu_secret_key_aqui
CRON_SECRET=define_un_secreto_largo_para_el_cron
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json

# Correo de cuentas (confirmación de registro y restablecer contraseña)
# Cuenta SMTP de un proveedor de correo (Google Workspace, Zoho, Brevo, Amazon SES...)
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_login_smtp
SMTP_PASS=tu_clave_smtp
SMTP_FROM="Smartbis <no-responder@smartbis.ai>"
# A dónde apuntan los enlaces de los correos (en local: http://localhost:5173)
APP_PUBLIC_URL=https://www.smartbis.ai
# Opcional: secreto para firmar los enlaces de confirmación (mínimo 32 caracteres).
# Si falta, se deriva de SUPABASE_SECRET_KEY.
EMAIL_LINK_SECRET=
# Opcional: logo de los correos (por defecto https://www.smartbis.ai/email/logo-smartbis.png)
EMAIL_LOGO_URL=
